# 8080 CCM SPA'siga tegishli (lokal stend), shuning uchun web-ssh backendi 8090 da.
PORT=8090
# Nomi "PATH" bo'lsa ham bu POSTGRES DSN'i (gorm postgres drayveri). Lokal stendda
# umumiy instansiyadagi `webssh` bazasi — musanna-platform/docker-compose.stack.yml.
DB_PATH=host=localhost port=54123 user=postgres password=postgres dbname=webssh sslmode=disable
# ===== musanna-platform OIDC (Authorization Code + PKCE) =====
# Kirish endi platforma orqali; Google oqimi butunlay olib tashlandi.
# Bu CONFIDENTIAL client: kodni almashtirish server tomonda bo'ladi, ya'ni
# MUSANNA_CLIENT_SECRET haqiqiy sir va u obrazga emas, secret store'ga yoziladi.
MUSANNA_AUTHORITY=https://localhost:7001
MUSANNA_CLIENT_ID=webssh
MUSANNA_CLIENT_SECRET=
MUSANNA_REDIRECT_URL=http://localhost:8090/auth/musanna/callback
JWT_SECRET=your-secure-jwt-secret
ENCRYPTION_KEY=your-32-byte-encryption-key-1234
FRONTEND_URL=http://localhost:5173

# ===== Multi-factor authentication (MFA) =====
# MFA endi PLATFORMADA: odam musanna hisobiga kirishda o'sha yerda ikkinchi
# omildan o'tadi, shuning uchun bu yerda takroran so'ralmaydi. `false` bo'lib
# qolishi ATAYLAB — `true` qilish foydalanuvchini bitta seansda IKKI MARTA
# MFA'dan o'tishga majbur qiladi.
#
# Endpointlar va Telegram Mini App yuzasi joyida qoldi: ular ishlayotgan
# mahsulot qismi va ularni olib tashlash MFA bilan bog'liq bo'lmagan
# funksiyani ham yo'q qilardi.
MFA_REQUIRED=false

# Length of a DeviceSession (how long after a successful biometric/TOTP unlock
# the user stays "active" before the next prompt). Go duration syntax.
MFA_SESSION_TTL=30m

# 32 bytes of randomness, hex-encoded (64 chars). Signs the short-lived cookie
# the Telegram Mini App receives after exchanging initData. Generate with:
#   openssl rand -hex 32
MFA_COOKIE_KEY=

# Telegram bot token — used to HMAC-verify Mini App initData payloads.
# Must match the token the remofy-bot project runs under.
TELEGRAM_BOT_TOKEN=

# Optional grace period for existing users when MFA_REQUIRED is first turned on.
# RFC3339 datetime. Users whose accounts predate this rollout get warning-only
# until this date, after which they are gated like everyone else.
# Leave empty to enforce immediately.
MFA_GRACE_UNTIL=

# WebAuthn Relying Party ID — the domain that owns the registered passkeys.
# Must be a registrable suffix of every origin that will call WebAuthn.
# When the frontend, backend, and Mini App live on different subdomains
# (e.g. remofy.musanna.uz / api-remofy.musanna.uz), set this to their
# common parent (musanna.uz). Leave empty to use the host of PUBLIC_BASE_URL,
# which only works when everything is on the same hostname.
WEBAUTHN_RP_ID=

# Comma-separated list of origins permitted to start WebAuthn ceremonies.
# Required when the frontend and Mini App live on different subdomains.
# Leave empty to use PUBLIC_BASE_URL (+ FRONTEND_URL when present).
WEBAUTHN_ORIGINS=
